# .env.example
# Скопируй в .env и настрой:
#   cp .env.example .env

# Порт HTTP-сервера подписок наружу
HTTP_PORT=8080

# Директория с SSH-ключами на ХОСТЕ (где запущен Docker)
# На Ubuntu VPS: /root/.ssh
# На Windows: C:/Users/YourName/.ssh
SSH_DIR=/root/.ssh

# Дефолтные настройки SSH
DEFAULT_SSH_USER=root
DEFAULT_SSH_PORT=22
DEFAULT_SSH_KEY=/root/.ssh/id_ed25519

# Уровень логирования
LOG_LEVEL=INFO